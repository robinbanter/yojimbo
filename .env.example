# Required for standard mainnet reads; never expose this to the browser.
TATUM_API_KEY=
# Bech32 suiprivkey1... for a dedicated, limited-funds Ed25519 wallet.
YOJIMBO_BOT_KEY=
# Optional explicit bot-owned manager ID; otherwise discovered from the registry.
YOJIMBO_MARGIN_MANAGER_ID=
# Walrus Memory mainnet delegate credentials.
MEMWAL_MAINNET_KEY=
MEMWAL_MAINNET_ACCOUNT_ID=
# OpenRouter tool-calling chat.
OPENROUTER_API_KEY=
YOJIMBO_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional Telegram channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Defence and opening size limits, in USDC.
YOJIMBO_MAX_DEFENCE_USDC=10
YOJIMBO_DAILY_USDC=30
YOJIMBO_ALERT_RATIO=1.5
# Optional dev read and simulation override; shown as a warning badge. Use a Sui gRPC endpoint.
YOJIMBO_DEV_SUI_RPC=
# Leave unset for dry runs. Only this exact value permits mainnet writes with Tatum.
YOJIMBO_ALLOW_MAINNET=
PORT=8787
# Optional Vite port; Vite proxies to PORT.
VITE_PORT=5173
